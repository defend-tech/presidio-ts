{
  "name": "presidio-ts",
  "version": "0.0.1",
  "private": true,
  "description": "Presidio PII detection and anonymization - TypeScript port",
  "workspaces": [
    "packages/core",
    "packages/analyzer",
    "packages/anonymizer",
    "packages/image-redactor",
    "packages/structured",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build -w packages/core",
    "build:analyzer": "npm run build -w packages/analyzer",
    "build:anonymizer": "npm run build -w packages/anonymizer",
    "build:image": "npm run build -w packages/image-redactor",
    "build:structured": "npm run build -w packages/structured",
    "build:cli": "npm run build -w packages/cli",
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm run test -w packages/core",
    "test:analyzer": "npm run test -w packages/analyzer",
    "test:anonymizer": "npm run test -w packages/anonymizer",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
