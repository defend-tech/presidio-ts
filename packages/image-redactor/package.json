{
  "name": "@presidio/image-redactor",
  "version": "0.0.1",
  "description": "Presidio image redaction engine",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup-node src/index.ts --dts --format esm,cjs --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@presidio/analyzer": "*",
    "@presidio/core": "*",
    "dicom-parser": "^1.8.21",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
