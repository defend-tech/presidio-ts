{
  "name": "@defend-tech/presidio-analyzer",
  "version": "0.0.1",
  "description": "Presidio PII analyzer engine and recognizers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup-node src/index.ts --dts --format esm,cjs --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@defend-tech/presidio-core": "^0.0.1",
    "ibantools": "^4.5.4",
    "libphonenumber-js": "^1.13.8",
    "tldts": "^7.4.8",
    "zod": "^4.4.3"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defend-tech/presidio-ts.git",
    "directory": "packages/analyzer"
  },
  "homepage": "https://github.com/defend-tech/presidio-ts#readme",
  "bugs": { "url": "https://github.com/defend-tech/presidio-ts/issues" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
