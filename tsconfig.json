{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@defend-tech/presidio-core": ["./packages/core/src"],
      "@defend-tech/presidio-core/*": ["./packages/core/src/*"],
      "@defend-tech/presidio-analyzer": ["./packages/analyzer/src"],
      "@defend-tech/presidio-analyzer/*": ["./packages/analyzer/src/*"],
      "@defend-tech/presidio-anonymizer": ["./packages/anonymizer/src"],
      "@defend-tech/presidio-anonymizer/*": ["./packages/anonymizer/src/*"],
      "@defend-tech/presidio-image-redactor": ["./packages/image-redactor/src"],
      "@defend-tech/presidio-image-redactor/*": ["./packages/image-redactor/src/*"],
      "@defend-tech/presidio-structured": ["./packages/structured/src"],
      "@defend-tech/presidio-structured/*": ["./packages/structured/src/*"],
      "@defend-tech/presidio-cli": ["./packages/cli/src"],
      "@defend-tech/presidio-cli/*": ["./packages/cli/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
